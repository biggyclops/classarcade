{
  "name": "classarcade-concepts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "games:catalog": "node scripts/generate-game-catalog.mjs",
    "dev": "npm run chapter:build && npm run games:catalog && node next-chapter/server/dev.mjs",
    "build": "npm run chapter:build && npm run games:catalog && tsc -b && vite build",
    "test": "playwright test",
    "portable": "npm run build && node scripts/portable.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "chapter:build": "node scripts/build-next-chapter.mjs",
    "chapter:test": "node --test next-chapter/model.test.mjs next-chapter/server/api.test.mjs",
    "build:host": "npm run build && node scripts/build-chapter-server.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "motion": "^12.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@playwright/test": "^1.51.0",
    "@axe-core/playwright": "^4.10.0"
  }
}
